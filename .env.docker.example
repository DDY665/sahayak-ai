# ==========================================
# SahayakAI Docker Environment Configuration
# Copy this file to .env before running `docker compose up`
# ==========================================

# LLM Provider & Credentials
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_API_KEY=your_groq_chat_api_key_here
GROQ_SUMMARY_API_KEY=your_groq_summary_api_key_here
VISION_MODEL=qwen/qwen3.8-27b

# Authentication & Security
JWT_SECRET=change_this_to_a_secure_random_string_in_production

# Database Configuration
# Leave as mongodb://mongodb:27017/sahayakai to use the included docker MongoDB service,
# OR replace with your MongoDB Atlas connection string:
MONGO_URI=mongodb://mongodb:27017/sahayakai
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/sahayakai?retryWrites=true&w=majority

# App Ports & Storage
PORT=8000
VECTOR_DB_DIR=/app/vectorstore
UPLOAD_DIR=/app/uploads

# Embeddings & Retrieval
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
TOP_K=4
MIN_RETRIEVAL_CONFIDENCE=0.0
HF_HUB_OFFLINE=1

# CORS & Frontend Origin (Comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:8000
